{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "jsx": "preserve",
    "ignoreDeprecations": "6.0"
  },
  "include": [".astro/types.d.ts", "src/**/*.ts", "src/**/*.astro"]
}
