---
import Layout from "@/layouts/Container.astro";
import Hero from "@/components/Hero/Container.astro";
import Skills from "@/components/Skills/Container.astro";
import Projects from "@/components/Projects/Container.astro";
import Experiences from "@/components/Experiences/Container.astro";
import Next from "@/components/Next/Container.astro";
import Hobbies from "@/components/Hobbies/Container.astro";
import StackTracker from "@/components/ui/StackTracker.astro";

const sections = [
  { title: "Introduction", selector: "hero" },
  { title: "Compétences", selector: "skills" },
  { title: "Projets", selector: "projects" },
  { title: "Expériences", selector: "experiences-wrapper" },
  { title: "Loisirs", selector: "hobbies" },
  { title: "Et ensuite", selector: "next" },
];
---

<Layout
  lang="fr"
  title="Dorian Gauron — Développeur Web"
  description="Développeur web passionné par la création d'applications web, bots, et outils."
>
  <StackTracker slot="fixed-ui" sections={sections} />

  <main>
    <Hero />
    <Skills />
    <Projects />
    <div data-component="experiences-wrapper">
      <Experiences />
    </div>
    <Hobbies />
    <Next />
  </main>
</Layout>
