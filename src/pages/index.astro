---
import Layout from "@/layouts/Container.astro";
import Hero from "@/components/Hero/Container.astro";
import Skills from "@/components/Skills/Container.astro";
import Projects from "@/components/Projects/Container.astro";
import Experiences from "@/components/Experiences/Container.astro";
import Next from "@/components/Next/Container.astro";
import ArticlesV2 from "@/components/Articles/ContainerV2.astro";
import Hobbies from "@/components/Hobbies/Container.astro";
import StackTracker from "@/components/ui/StackTracker/Container.astro";

const sections = [
  { title: "Introduction", selector: "hero" },
  { title: "Skills", selector: "skills" },
  { title: "Projects", selector: "projects" },
  { title: "Experiences", selector: "experiences" },
  { title: "Hobbies", selector: "hobbies" },
  { title: "Articles", selector: "articles" },
  { title: "Next", selector: "next" },
];
---

<Layout>
  <StackTracker slot="fixed-ui" sections={sections} />

  <main>
    <Hero />
    <Skills />
    <Projects />
    <Experiences />
    <Hobbies />
    <ArticlesV2 />
    <Next />
  </main>
</Layout>
