---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Skill from "../components/Skill.astro";
import Projects from "../components/Projects.astro";
import Next from "../components/Next.astro";
import Secondary from "../components/projects/Secondary.vue";
import Experiences from "../components/Experiences.astro";
import { fetchProjects } from "../utils/project.ts";
import { fetchProjectsFake } from "../utils/fake.ts";

const isProd = import.meta.env.PROD;

const projects = isProd ? await fetchProjects() : await fetchProjectsFake();
---

<Layout>
    <main>
        <Hero />
        <Skill />
        <div class="wrapper projects__wrapper">
            <Projects projects={projects.Main} />
            <Secondary secondary={projects.Secondary} client:load />
        </div>
        <Experiences />
        <Next />
    </main>
</Layout>
