---
import Favicon from "../images/favicon.ico";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Dorian Gauron — Software Engineer",
  description = "Software engineer building web apps, bots, and tools.",
  image = "/og.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<head>
  <meta charset="UTF-8" />

  <title>{title}</title>

  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image, Astro.site)} />

  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="icon" type="image/svg+xml" href={Favicon} />

  <link rel="alternate" hreflang="en" href="https://dorian-gauron.com/" />
  <link rel="alternate" hreflang="fr" href="https://dorian-gauron.com/fr/" />
  <link
    rel="alternate"
    hreflang="x-default"
    href="https://dorian-gauron.com/"
  />

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Dorian Gauron",
      url: "https://dorian-gauron.com",
      jobTitle: "Software Engineer",
    })}
  />

  <meta
    name="google-site-verification"
    content="fZKxGOLH5_q7eTUTuu898KnkDUCGkLukhSQ1LCDrjW8"
  />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <script
    is:inline
    async
    src="https://www.googletagmanager.com/gtag/js?id=G-R71TJGC1W4"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(...args) {
      dataLayer.push(args);
    }
    gtag("js", new Date());

    gtag("config", "G-R71TJGC1W4");
  </script>
</head>
