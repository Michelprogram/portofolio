---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Meteor from "../components/Meteor.astro";
import Cursor from "../components/Cursor.astro";
import Favicon from "../images/favicon.ico";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
      <meta charset="UTF-8" />
          <link rel="icon" type="image/svg+xml" href={Favicon} />
          <meta name="viewport" content="width=device-width, initial-scale=1.0" />
          <title>Gauron Dorian</title>
          <meta name="google-site-verification" content="fZKxGOLH5_q7eTUTuu898KnkDUCGkLukhSQ1LCDrjW8" />
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
  </head>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-R71TJGC1W4"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-R71TJGC1W4');
  </script>
  <body>
    <Cursor />
    <Meteor />
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style is:global lang="scss">
  @use "../../assets/styles/utils/colors" as *;
  @use "../../assets/styles/utils/fonts" as *;
  @use "../../assets/styles/utils/variables" as *;


  html {
    box-sizing: border-box;
    font-size: 100%;
    cursor: none;
  }
  *,
  *::before,
  *::after {
    box-sizing: inherit;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  p {
    line-height: 1.3;
    font-size: 1em;
    font-size: clamp(1rem, 0.79rem + 0.89vw, 1.125em);
    color: $text-2;
  }

  a.underline {
    font-size: 1rem;
    line-height: 1.625;
    letter-spacing: 2.29px;
    font-weight: 700;
    text-transform: uppercase;
    color: $text-1;
    text-decoration: none;
    background-image: linear-gradient(to right, $green 75%, $green 75%);
    background-repeat: repeat-x;
    background-size: 8px 4px;
    background-position: 0 1.625em;
    padding-bottom: 8px;

    transition: color 250ms ease-in-out;

    &:hover {
      color: $green;
    }
  }

  body {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    background-color: $body-bg;
    color: $text-1;
    font-size: $fs-18;
    line-height: 1.56;
    overflow-x: hidden;
  }

  .wrapper {
    width: calc(100% - 2rem);
    max-width: $container-size;
    margin-inline: auto;
    position: relative;

    padding-bottom: 60px;
    border-bottom: 2px solid $text-1;

    @media (min-width: px-to-rem(600px)) {
      /*
      width: calc(100% - px-to-rem(60px));
      */
    }
  }
</style>
