---
import Header from "@/components/Header/Container.astro";
import Footer from "@/components/Footer/Container.astro";
import Meteor from "@/components/ui/Meteor.astro";
import "../styles/global.css";
import HeaderTag from "./Header.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
}

const {
  title = "Dorian Gauron — Software Engineer",
  description = "Software engineer building web apps, bots, and tools.",
  image = "/og.jpg",
  lang = "en",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <HeaderTag title={title} description={description} image={image} />
  <body>
    <Meteor />
    <slot name="fixed-ui" />
    <div data-gsap="smooth-wrapper">
      <div data-gsap="smooth-content" class="relative">
        <Header />
        <slot />
        <Footer />
      </div>
    </div>
  </body><script>
    import { ScrollSmoother } from "gsap/ScrollSmoother";

    const initScroll = () => {
      if (ScrollSmoother.get()) return ScrollSmoother.get();
      return ScrollSmoother.create({
        wrapper: "[data-gsap='smooth-wrapper']",
        content: "[data-gsap='smooth-content']",
        smooth: 1.2,
        effects: true,
        normalizeScroll: true,
        smoothTouch: 0.1,
      });
    };

    initScroll();
  </script>
</html>
