---
import { useI18n } from "@/composables";
import { Image } from "astro:assets";

const { translation } = useI18n(Astro.currentLocale);
const {
  next: { title, description, animationDescription },
} = translation;
---

<section
  class="size-full flex gap-8 flex-col items-center justify-center w-6xl m-auto border-t-2 border-solid"
  data-component="next"
>
  <h2 class="text-7xl w-full tracking-wide mt-12">{title}</h2>
  <div class="grid grid-cols-[1fr_0.5fr] grid-rows-1 gap-5 items-center">
    <p>{description}</p>
    <div class="flex flex-col items-center justify-center h-[100px] gap-5">
      <Image
        class="size-[50px]"
        alt="flying animation"
        loading="lazy"
        width="50"
        height="50"
        src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Travel%20and%20places/Airplane.png"
      />
      <span class="text-lg text-gray-500 italic">{animationDescription}</span>
    </div>
  </div>
</section>
