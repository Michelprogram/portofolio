---
import ProjectAstroComponent from "./Project.astro";
import { useI18n } from "@/composables";
import { getCollection } from "astro:content";

const { translation, locale } = useI18n(Astro.currentLocale);
const {
  project: { title },
} = translation;

const items = (await getCollection("projects")).map((p) => ({
  ...p.data,
  title: p.data[locale()].title,
  description: p.data[locale()].description,
}));
---

<section
  class="border-t-2 w-5/6 flex gap-8 flex-col items-center justify-center m-auto border-solid pb-5 xl:pb-12 xl:mt-12 xl:border-t-0 xl:border-b-2 xl:w-6xl xl:size-full"
  data-component="projects"
>
  <h2 class="w-full text-5xl mt-4 tracking-wide xl:mt-0 xl:text-7xl">
    {title}
  </h2>
  <div class="w-full flex flex-col">
    {
      items.map((project, index) => (
        <ProjectAstroComponent project={project} index={index} />
      ))
    }
  </div>
</section>
