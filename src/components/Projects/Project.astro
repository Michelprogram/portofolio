---
import { Image } from "astro:assets";
import { useImage } from "@/composables/images";
import { isPresent } from "@/utils/optional";
import type { Project } from "@/collections";

interface Props {
  project: Project & { title: string; description: string };
  index: number;
}

const { project, index } = Astro.props;

const { image } = useImage({ path: project.image, folder: "projects" });
---

<div class="flex flex-col last:**:data-divider:hidden">
  <div
    class="grid grid-cols-5 content-center h-75"
    data-component="project"
    id={`project-${index}`}
  >
    <div class="hidden lg:block lg:col-span-2 relative">
      <span class="tracking-widest hidden md:block"
        >{String(index + 1).padStart(3, "0")}</span
      >
      {
        isPresent(image) && (
          <Image
            data-gsap-image
            class="absolute scale-0 opacity-0 top-0 left-0 w-55 h-75 object-contain rounded-md z-10"
            src={image}
            width={220}
            height={300}
            alt={project.title}
          />
        )
      }
    </div>
    <div
      class="col-span-5 flex flex-col gap-4 items-center text-center lg:col-span-3 lg:items-start lg:text-left"
    >
      <h3 class="text-3xl font-medium z-0">{project.title}</h3>
      <p class="text-lg text-gray-400">{project.description}</p>
      <div class="gap-2 hidden md:flex">
        {
          project.technologies.map((technology) => (
            <span class=" bg-gray-800 rounded-md px-2 py-1 text-sm">
              {technology}
            </span>
          ))
        }
      </div>
      <div class="flex gap-4 items-center">
        <a href={project.link} class="underline relative" target="_blank">
          <span class="font-medium relative inline-block py-2">
            Get more details
            <span
              class="absolute bottom-0 left-0 block h-0.5 w-full bg-primary-green"
              aria-hidden="true"></span>
          </span></a
        >
      </div>
    </div>
  </div>

  <div data-divider class="h-0.5 w-5/6 mx-auto bg-white rounded-2xl"></div>
</div>

<script>
  import { isAbsent } from "@/utils";
  import { useGsap } from "@/composables";

  const { worker } = useGsap();

  document
    .querySelectorAll<HTMLDivElement>("[data-component='project']")
    .forEach((root) => {
      worker({ selector: `#${root.id}` }, (gsap, root) => {
        const image = root.querySelector<HTMLImageElement>("[data-gsap-image]");
        if (isAbsent(image)) return;

        const container = image.parentElement;
        if (isAbsent(container)) return;

        const IMAGE_W = Number(container.style.width);
        const IMAGE_H = Number(container.style.height);

        const getOriginalCenter = () => {
          const rect = container.getBoundingClientRect();
          return {
            x: rect.left + IMAGE_W / 2,
            y: rect.top + IMAGE_H / 2,
          };
        };

        let originalPosition = getOriginalCenter();
        const FAR = 400;
        const MAX = 0.5;
        const MIN = 0.3;
        let lastX = 0;
        let idleTimer: ReturnType<typeof setTimeout>;

        const xTo = gsap.quickTo(image, "x", {
          duration: 0.25,
          ease: "power2.out",
        });
        const yTo = gsap.quickTo(image, "y", {
          duration: 0.25,
          ease: "power2.out",
        });
        const rotateTo = gsap.quickTo(image, "rotation", {
          duration: 0.25,
          ease: "power2.out",
        });

        const proxy = { brightness: 1 };

        const brightnessQuick = gsap.quickTo(proxy, "brightness", {
          duration: 0.5,
          ease: "power2.out",
          onUpdate: () => {
            image.style.filter = `brightness(${proxy.brightness})`;
          },
        });

        root.addEventListener("mouseenter", (e: MouseEvent) => {
          originalPosition = getOriginalCenter();

          lastX = e.clientX;
          gsap.set(image, { transformOrigin: "center center" });
          gsap.to(image, {
            opacity: 1,
            scale: 1,
          });
        });

        let lastBright = 1;

        root.addEventListener("mousemove", (e: MouseEvent) => {
          const deltaX = e.clientX - lastX;
          lastX = e.clientX;

          const dx = e.clientX - originalPosition.x;
          const dy = e.clientY - originalPosition.y;
          const dist = Math.hypot(dx, dy);

          const tilt = gsap.utils.clamp(-10, 10, -deltaX * 0.8);
          rotateTo(tilt);
          lastBright += 0.003;
          const bright = gsap.utils.clamp(1, 1.2, lastBright);

          brightnessQuick(bright);

          clearTimeout(idleTimer);
          idleTimer = setTimeout(() => {
            rotateTo(0);
            brightnessQuick(1);
            lastBright = 1;
          }, 200);

          const strength = gsap.utils.clamp(
            MIN,
            MAX,
            gsap.utils.mapRange(0, FAR, MAX, MIN, dist),
          );

          xTo(dx * strength);
          yTo(dy * strength);
        });

        root.addEventListener("mouseleave", () => {
          clearTimeout(idleTimer);
          const tl = gsap.timeline();
          tl.to(image, {
            opacity: 0,
            scale: 0,
            rotation: 0,
          });
        });
      });
    });
</script>
