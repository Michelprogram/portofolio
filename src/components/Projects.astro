---
import type { Project } from "../utils/project";

import { preview, path } from "../utils/project";

interface Props {
    projects: Array<Project>;
}

const { projects } = Astro.props;
---

<section class="projects">
    <h2 class="projects__title">Projects</h2>
    <h3 class="projects__secondary__title">
        Favorites ({projects.length})
    </h3>
    <div class="projects__container">
        {
            projects.map((project, index) => {
                return (
                    <div class="projects__container__info" data-index={index}>
                        <div class="projects__container__info__icon">
                            <img
                                src={path(project.icon)}
                                alt="icon"
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                        <div class="projects__container__info__name">
                            <h3>{project.name}</h3>
                        </div>
                        <div class="projects__container__info__content">
                            <div class="projects__container__info__content__title">
                                <img
                                    src={path(project.icon)}
                                    alt="project icon"
                                />
                                <h3>{project.name}</h3>
                            </div>
                            <div class="projects__container__info__content__container">
                                <div class="projects__container__info__content__container__left">
                                    <div class="projects__container__info__content__container__left__preview">
                                        <img
                                            src={preview(
                                                project.name,
                                                project.default_branch,
                                            )}
                                            onerror="this.src='https://github.githubassets.com/assets/GitHub-Mark-ea2971cee799.png'"
                                            alt="Preview project"
                                            decoding="async"
                                        />
                                    </div>
                                    <div class="projects__container__info__content__container__left__topics">
                                        {project.topics.map((topic) => {
                                            return <span>{topic}</span>;
                                        })}
                                    </div>
                                </div>

                                <div class="projects__container__info__content__container__right">
                                    <p>{project.description}</p>
                                    <a
                                        href={project.html_url}
                                        class="underline"
                                    >
                                        View code
                                    </a>
                                    {project.homepage != "" && (
                                        <a
                                            href={project.homepage}
                                            class="underline"
                                        >
                                            Visite web site
                                        </a>
                                    )}
                                </div>
                            </div>

                            <img
                                class="projects__container__info__content__close"
                                src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Symbols/Cross%20Mark.png"
                                alt="Cross Mark"
                            />
                        </div>
                    </div>
                );
            })
        }
    </div>
</section>

<style lang="scss" scoped>
    @import "../../assets/styles/utils/functions";
    @import "../../assets/styles/utils/colors";
    @import "../../assets/styles/utils/fonts";
    @import "../../assets/styles/utils/animation";

    .projects {
        &__title {
            font-size: clamp(2.5rem, 0.7rem + 6.68vw, 5.5rem);
            margin-bottom: 20px;
        }

        &__secondary__title {
            margin: 10px 0px;
        }

        &__container {
            display: flex;
            justify-content: space-between;
            height: 600px;

            &__info {
                border-radius: 5px;
                position: relative;
                overflow: hidden;
                cursor: pointer;
                z-index: 5;
                width: 100%;
                display: block;
                transition: all 0.8s ease-in-out;

                &:hover {
                    .projects__container__info__name {
                        opacity: 1;
                        transform: translateX(0);
                    }
                    .projects__container__info__icon {
                        opacity: 0.25;
                    }
                }

                &__icon {
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                    align-items: center;
                    height: 100%;
                    transition: opacity 0.3s ease-in-out;

                    img {
                        width: 85%;
                        object-fit: contain;
                    }
                }

                &__name {
                    position: absolute;
                    height: 100%;
                    width: 100%;
                    bottom: 0;
                    text-align: center;
                    display: flex;
                    flex-direction: column;
                    justify-content: end;
                    writing-mode: vertical-rl;
                    opacity: 0;
                    transform: translateX(-35%);
                    transition: all 0.3s ease-in-out;
                }

                &__content {
                    position: relative;
                    text-align: center;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    gap: 2%;
                    width: 100%;

                    &__title {
                        padding: 1% 0%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        gap: 15px;

                        img {
                            width: 50px;
                        }

                        p {
                            font-size: clamp(1.5rem, 0.7rem + 1.68vw, 2.5rem);
                        }
                    }

                    &__container {
                        display: grid;
                        grid-template-columns: 4fr 1fr;
                        grid-template-rows: 1fr;
                        grid-column-gap: 2%;
                        width: 100%;
                        height: minmax(0, 400px);

                        &__left {
                            grid-area: 1 / 1 / 2 / 2;

                            height: 100%;

                            &__preview {
                                img {
                                    width: 80%;
                                    object-fit: cover;
                                    border-radius: 5px;
                                }
                            }

                            &__topics {
                                display: flex;
                                justify-content: center;
                                gap: 5%;
                                width: 100%;
                            }
                        }

                        &__right {
                            grid-area: 1 / 2 / 2 / 3;

                            display: flex;
                            flex-direction: column;

                            gap: 5%;

                            align-items: center;
                        }
                    }

                    &__close {
                        position: absolute;
                        cursor: pointer;
                        top: 0;
                        right: 0;
                        width: 30px;
                        z-index: 10;
                    }
                }
            }
        }

        .opening,
        .open {
            cursor: default;

            &:hover {
                .projects__container__info__icon {
                    opacity: 1;
                }
            }

            .projects__container__info {
                &__name {
                    display: none;
                }
            }
        }

        .opening {
            animation-duration: 0.8s;
            animation-name: Opening;

            .projects__container__info {
                &__content {
                    display: none;
                }
                &__icon {
                    animation-duration: 1.3s;
                    animation-name: OpacityOut;
                    animation-fill-mode: forwards;
                }
            }
        }

        .projects__container__info.open {
            display: flex;
            align-items: center;
            justify-content: center;

            .projects__container {
                &__info {
                    &__content {
                        display: flex;
                        animation-duration: 1s;
                        animation-name: OpacityIn;
                        animation-fill-mode: forwards;
                    }
                    &__icon {
                        display: none;
                    }
                }
            }
        }

        .close {
            width: 0%;
        }
    }
</style>
<script>
    import { ProjectBehavior } from "../utils/utils";

    const project = new ProjectBehavior(
        ".projects__container__info",
        ".projects__container__info__content__close",
    );

    project.watcher();
</script>
