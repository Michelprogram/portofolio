---
import { useI18n } from "@/composables";
import { computeDateFromBeginning } from "@/utils/utils";

import Path from "./Path.astro";

import { getCollection } from "astro:content";

const { translation, locale } = useI18n(Astro.currentLocale);
const {
  experience: { title },
} = translation;

const experiences = (await getCollection("experiences"))
  .sort(
    (a, b) =>
      computeDateFromBeginning(new Date(b.data.from)) -
      computeDateFromBeginning(new Date(a.data.from)),
  )
  .map((experience) => {
    return {
      ...experience.data,
      title: experience.data[locale()].title,
      description: experience.data[locale()].description,
    };
  });
---

<section
  class="mt-12 m-auto size-full flex gap-8 flex-col w-6xl pb-12"
  data-component="experiences"
>
  <h2 class="text-7xl w-full tracking-wide">{title}</h2>
  <div
    class="flex flex-col gap-6 relative w-full min-h-[500px] perspective-distant"
    data-container
  >
    {
      experiences.map((experience, idx) => (
        <div
          class="h-[500px] border-2 w-full absolute perspective-distant"
          style={`z-index: ${idx + 1}`}
          data-card
        >
          <div
            class="grid grid-cols-1 grid-rows-5 size-full"
            style={`background-color: rgb(${idx + 1},0,0)`}
          >
            <div class="row-span-1 border-2 size-full">
              <p>
                {experience.title} {idx}
              </p>
            </div>
            <div class="row-span-3 border-2 size-full">
              <p>Content</p>
            </div>
            <div class="row-span-1 border-2 size-full">
              <p>Footer</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
<script>
  import { useGsap } from "@/composables";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrollSmoother } from "gsap/ScrollSmoother";

  const { worker } = useGsap();

  worker(
    {
      selector: "[data-component='experiences']",
    },
    (gsap, root) => {
      const cards = root.querySelectorAll("[data-card]");

      const tl = gsap.timeline();

      const stg = ScrollTrigger.create({
        trigger: root,
        markers: true,
        start: "top top",
        pin: true,
        scrub: true,
        end: "+=2000",
        animation: tl,
      });

      cards.forEach((card, idx) => {
        if (idx == 0) {
          gsap.set(card, {
            y: 0,
          });
        } else {
          gsap.set(card, {
            y: 600,
          });
        }

        tl.to(card, {
          opacity: 1,
          y: idx * 20,
          duration: 0.8,
        }).addLabel(`card-${idx}`);

        [...cards].slice(0, idx).forEach((card, iidx) => {
          const depth = idx - iidx;
          tl.to(
            card,
            {
              y: idx * 20,
              scale: 1 - depth * 0.04,
              opacity: 1 - depth * 0.2,
              rotateX: 8 * depth,
              transformOrigin: "top center",
              duration: 0.8,
            },
            "<",
          );
        });

        card.addEventListener("click", (evt) => {
          const position = stg.labelToScroll(`card-${idx}`);
          const smoother = ScrollSmoother.get();
          if (smoother) smoother.scrollTo(position, true, "top center");
        });
      });
    },
  );
</script>
