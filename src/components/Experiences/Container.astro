---
import { useI18n } from "@/composables";
import { computeDateFromBeginning } from "@/utils/utils";
import Experience from "./Experience.astro";

import { getCollection } from "astro:content";

const { translation, locale } = useI18n(Astro.currentLocale);
const {
  experience: { title },
} = translation;

const experiences = (await getCollection("experiences"))
  .sort(
    (a, b) =>
      computeDateFromBeginning(new Date(b.data.from)) -
      computeDateFromBeginning(new Date(a.data.from)),
  )
  .map((experience) => {
    return {
      ...experience.data,
      title: experience.data[locale()].title,
      description: experience.data[locale()].description,
    };
  });
---

<section
  class="m-auto mt-12 flex size-full w-6xl flex-col gap-8 pb-12"
  data-component="experiences"
>
  {
    experiences.map((experience, index) => (
      <Experience
        experience={experience}
        index={index}
        width={400}
        height={150}
      />
    ))
  }
  <h2 class="w-full text-7xl tracking-wide">{title}</h2>
  <div class="relative my-18 flex h-175 w-full flex-col gap-6" data-container>
    <div class="relative size-full">
      <svg
        class="absolute top-[50%] left-[50%] z-10 size-full translate-x-[-50%] translate-y-[-50%]"
        width="1059"
        height="334"
        viewBox="0 0 1059 334"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          data-path
          d="M5.50107 328.001C5.50107 328.001 142.204 73.2927 298.001 50.5007C475.926 24.4715 505.341 307.57 685.001 300.001C869.057 292.246 1053.5 5.50067 1053.5 5.50067"
          stroke="#4EE1A0"
          stroke-width="11"
          stroke-linecap="round"></path>

        <g data-checkpoints>
          {
            experiences.map((exp, index) => (
              <g
                data-checkpoint={index}
                data-threshold={exp.threshold}
                class="group cursor-pointer"
                role="button"
                tabindex="0"
              >
                <circle
                  r="16"
                  class="fill-primary-green/10 scale-75 opacity-0 transition-all duration-300 group-hover:scale-100 group-hover:opacity-100"
                />
                <circle
                  r="7"
                  class="group-hover:stroke-primary-green fill-neutral-900 stroke-white/40 stroke-2 transition-colors"
                />
                <circle
                  r="3.5"
                  class="group-hover:fill-primary-green fill-white transition-colors"
                />
              </g>
            ))
          }
        </g>
      </svg>

      <svg
        class="absolute top-[50%] left-[50%] size-full translate-x-[-50%] translate-y-[-50%]"
        width="1059"
        height="334"
        viewBox="0 0 1059 334"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M5.50107 328.001C5.50107 328.001 142.204 73.2927 298.001 50.5007C475.926 24.4715 505.341 307.57 685.001 300.001C869.057 292.246 1053.5 5.50067 1053.5 5.50067"
          stroke="gray"
          stroke-opacity="0.4"
          stroke-width="11"
          stroke-dasharray="10 30"
          stroke-linecap="round"></path>
      </svg>
    </div>
  </div>
</section>
<script>
  import { useGsap } from "@/composables";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { useEventBus } from "@/utils";

  const { worker } = useGsap();

  worker(
    {
      selector: "[data-component='experiences']",
    },
    (gsap, root) => {
      const eventBus = useEventBus();

      const path = root.querySelector<SVGPathElement>("[data-path]");
      if (!path) return;
      const totalLength = path.getTotalLength();

      const checkpoints =
        root.querySelectorAll<SVGGElement>("[data-checkpoint]");

      checkpoints.forEach((cp) => {
        const threshold = Number(cp.dataset.threshold);
        const point = path.getPointAtLength((threshold / 100) * totalLength);

        gsap.set(cp, { x: point.x, y: point.y });

        cp.addEventListener("click", () => {
          const st = ScrollTrigger.getById("experiences-trigger");
          if (!st) return;

          const targetScroll =
            st.start + (threshold / 100) * (st.end - st.start);

          window.scrollTo({
            top: targetScroll,
            behavior: "smooth",
          });
        });
      });

      const tl = gsap.timeline();

      tl.from(path, {
        drawSVG: 0,
        ease: "none",
        duration: 1,
      });

      ScrollTrigger.create({
        id: "experiences-trigger",
        trigger: root,
        start: "top 5%",
        pin: true,
        scrub: true,
        end: "+=2000",
        animation: tl,
        onUpdate: (self) => {
          const res = Number((self.progress * 100).toFixed(0));

          eventBus.publish("experience:update", { progress: res });
        },
      });
    },
  );
</script>
