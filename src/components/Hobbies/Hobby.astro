---
import type { Hobby } from "@/collections";

interface Props {
  hobby: Omit<Hobby, "fr" | "en"> & {
    title: string;
    description: string;
  };
  index: number;
  width: number;
  height: number;
}

const { hobby, index, width, height } = Astro.props;

const getLinkDomain = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
};
---

<div
  data-cards
  data-index={index}
  style={{
    width: `${width}px`,
    height: `${height}px`,
  }}
  class="bg-neutral-900/90 text-white border border-white/15 rounded-2xl p-6 absolute left-0 flex flex-col justify-between shadow-xl select-none"
>
  <div data-title>
    <h3 class="text-xl font-bold text-center">{hobby.title}</h3>
  </div>

  <div data-details class="opacity-0 flex flex-col gap-4 my-auto">
    <p class="text-sm text-center text-white/80 leading-relaxed">
      {hobby.description}
    </p>

    {
      hobby.links && hobby.links.length > 0 && (
        <div class="flex flex-wrap items-center justify-center gap-2 text-xs text-primary-green">
          {hobby.links.map((link, i) => (
            <>
              {i > 0 && <span class="text-white/40 select-none">•</span>}
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:underline hover:text-white transition-colors"
              >
                {getLinkDomain(link)}
              </a>
            </>
          ))}
        </div>
      )
    }
  </div>
</div>
