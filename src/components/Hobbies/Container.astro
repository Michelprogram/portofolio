---
import { useI18n } from "@/composables";
import { getCollection } from "astro:content";
import Hobby from "./Hobby.astro";

const { translation, locale } = useI18n(Astro.currentLocale);
const {
  hobbies: { title },
} = translation;

const hobbies = (await getCollection("hobbies")).map((hobby) => {
  return {
    ...hobby.data,
    title: hobby.data[locale()].title,
    description: hobby.data[locale()].description,
  };
});
---

<section
  class="m-auto flex size-full w-6xl flex-col items-center justify-center gap-8 border-t-2 border-solid"
  data-component="hobbies"
>
  <h2 class="mt-12 w-full text-7xl tracking-wide">{title}</h2>
  <div
    data-container
    class="relative flex h-125 w-full cursor-pointer items-center justify-center"
  >
    {
      hobbies.map((hobby, index) => (
        <Hobby hobby={hobby} index={index} width={240} height={400} />
      ))
    }
  </div>
</section>

<script>
  import { useGsap } from "@/composables";
  import { isAbsent } from "@/utils";

  const { worker } = useGsap();

  worker({ selector: "[data-component='hobbies']" }, (gsap, root) => {
    const cards = root.querySelectorAll<HTMLDivElement>("[data-cards]");
    const container = root.querySelector<HTMLDivElement>("[data-container]");

    if (isAbsent(container) || cards.length === 0) return;

    const W = container.offsetWidth;
    const C = cards[0].offsetWidth;
    const travel = W - C;
    const restBase = travel / 2;
    const size = cards.length;
    const step = travel / (size - 1);
    const mid = (size - 1) / 2;

    let isOpen = false;
    const openCoords: { x: number; y: number; rotation: number }[] = [];

    cards.forEach((_, idx) => {
      const dist = Math.abs(idx - mid);
      openCoords[idx] = {
        x: idx * step,
        y: -dist * 12,
        rotation: (idx - mid) * 4,
      };
    });

    const init = (i: number): gsap.TweenVars => ({
      transformOrigin: "left bottom",
      x: restBase + i * 8,
      y: i * -8,
      rotation: i * 2,
      scale: 1,
      zIndex: i,
      opacity: 1 - (size - 1 - i) * 0.175,
    });

    cards.forEach((card, i) => {
      gsap.set(card, init(i));

      const titleEl = card.querySelector<HTMLDivElement>("[data-title]");
      const details = card.querySelector<HTMLDivElement>("[data-details]");

      if (isAbsent(titleEl) || isAbsent(details)) return;

      gsap.set(titleEl, { y: 140 });

      const tl = gsap.timeline({ paused: true });
      tl.to(titleEl, {
        y: 0,
        duration: 0.25,
        ease: "power2.out",
      }).to(
        details,
        {
          opacity: 1,
          duration: 0.2,
          ease: "power1.out",
        },
        "-=0.1",
      );

      card.addEventListener("mouseenter", () => {
        if (!isOpen) return;

        gsap.to(card, {
          zIndex: 999,
          rotation: 0,
          scale: 1.08,
          y: openCoords[i].y - 15,
          duration: 0.25,
          ease: "power2.out",
        });

        tl.play();
      });

      card.addEventListener("mouseleave", () => {
        if (!isOpen) return;
        const target = openCoords[i];
        gsap.to(card, {
          zIndex: i,
          scale: 1,
          x: target.x,
          y: target.y,
          rotation: target.rotation,
          duration: 0.4,
          ease: "power2.out",
        });

        tl.reverse();
      });

      card.addEventListener("mousemove", (evt) => {
        if (!isOpen) return;
        const rect = card.getBoundingClientRect();
        const dx = evt.clientX - (rect.left + rect.width / 2);
        const dy = evt.clientY - (rect.top + rect.height / 2);

        gsap.to(card, {
          x: openCoords[i].x + dx * 0.15,
          y: openCoords[i].y + dy * 0.15,
          duration: 0.2,
          ease: "power1.out",
        });
      });
    });

    container.addEventListener("mouseenter", () => {
      isOpen = true;
      cards.forEach((card, idx) => {
        const dist = Math.abs(idx - mid);
        const target = openCoords[idx];

        gsap.to(card, {
          x: target.x,
          y: target.y,
          rotation: target.rotation,
          scale: 1,
          zIndex: idx,
          delay: dist * 0.05,
          duration: 1,
          ease: "elastic.out(1, 0.6)",
          overwrite: "auto",
          opacity: 1,
        });
      });
    });

    container.addEventListener("mouseleave", () => {
      isOpen = false;
      cards.forEach((card, i) => {
        const titleEl = card.querySelector<HTMLDivElement>("[data-title]");
        const details = card.querySelector<HTMLDivElement>("[data-details]");

        if (isAbsent(titleEl) || isAbsent(details)) return;

        gsap.to(titleEl, { y: 140, duration: 0.3, overwrite: "auto" });
        gsap.to(details, { opacity: 0, duration: 0.2, overwrite: "auto" });

        gsap.to(card, {
          ...init(i),
          duration: 0.9,
          ease: "elastic.out(1, 0.6)",
          overwrite: "auto",
        });
      });
    });
  });
</script>
