---
import { useI18n } from "@/composables";
import { getCollection } from "astro:content";

const { translation } = useI18n(Astro.currentLocale);
const {
  hobbies: { title },
} = translation;

const hobbies = await getCollection("hobbies");
---

<section
  class="size-full flex gap-8 flex-col items-center justify-center w-6xl m-auto border-t-2 border-solid"
  data-component="hobbies"
>
  <h2 class="text-7xl w-full tracking-wide mt-12">{title}</h2>
  <div
    data-container
    class="relative w-full flex items-center justify-center cursor-pointer h-[500px]"
  >
    {
      hobbies.map((article, index) => (
        <div
          data-cards
          class="bg-red-600 absolute left-0 w-[250px] h-[400px] flex items-center justify-center border-2 rounded-2xl"
        >
          <p class="text-center">Content</p>
        </div>
      ))
    }
  </div>
</section>
<script>
  import { useGsap } from "@/composables";
  import { Draggable } from "gsap/Draggable";

  const { worker } = useGsap();

  worker({ selector: "[data-component='hobbies']" }, (gsap, root) => {
    const cards = root.querySelectorAll<HTMLDivElement>("[data-cards]");
    const container = root.querySelector<HTMLDivElement>("[data-container]");

    const W = container.offsetWidth;
    const C = cards[0].offsetWidth;
    const restBase = (W - C) / 2;
    const size = cards.length;

    let coords = [];

    let isOpen = false;

    const defaultWaitingCardSettings = (i: number): gsap.TweenVars => {
      return {
        transformOrigin: "left bottom",
        x: restBase + i * 8,
        y: i * -8,
        rotation: i * 2,
        zIndex: i,
        opacity: 1 - (size - 1 - i) * 0.175,
      };
    };

    cards.forEach((card, i) => {
      gsap.set(card, defaultWaitingCardSettings(i));
    });

    container?.addEventListener("mouseenter", () => {
      const travel = W - C;
      const step = travel / (size - 1);
      const mid = (size - 1) / 2;

      isOpen = true;

      cards.forEach((card, idx) => {
        const dist = Math.abs(idx - mid);
        gsap.to(card, {
          x: idx * step,
          y: -dist * 12,
          rotation: (idx - mid) * 4,
          delay: dist * 0.05,
          duration: 1,
          ease: "elastic.out(1, 0.6)",
          overwrite: "auto",
          opacity: 1,
        });
        coords[idx] = { x: idx * step, y: -dist * 12 };
      });
    });

    container?.addEventListener("mouseleave", () => {
      isOpen = false;
      cards.forEach((card, i) => {
        gsap.to(card, {
          ...defaultWaitingCardSettings(i),
          duration: 0.9,
          ease: "elastic.out(1, 0.6)",
        });
      });
      coords = [];
    });

    cards.forEach((card, idx) => {
      card.addEventListener("pointerenter", () => {
        if (!isOpen) return;

        gsap.to(card, {
          zIndex: 999,
          scale: 1.04,
          duration: 0.25,
          ease: "power2.out",
        });
      });

      card.addEventListener("pointerleave", () => {
        if (!isOpen) return;

        const travel = W - C;
        const step = travel / (size - 1);
        const mid = (size - 1) / 2;
        const dist = Math.abs(idx - mid);

        gsap.to(card, {
          zIndex: idx,
          scale: 1,
          x: idx * step,
          y: -dist * 12,
          rotation: (idx - mid) * 4,
          delay: dist * 0.05,
          duration: 1,
          ease: "elastic.out(1, 0.6)",
          overwrite: "auto",
          opacity: 1,
        });
      });

      card.addEventListener("pointermove", (evt) => {
        const rect = card.getBoundingClientRect();
        const dx = evt.clientX - (rect.left + rect.width / 2);
        const dy = evt.clientY - (rect.top + rect.height / 2);

        const offsetX = dx * 0.15;
        const offsetY = dy * 0.15;

        gsap.to(card, {
          x: coords[idx].x + offsetX,
          y: coords[idx].y + offsetY,
        });
      });
    });
  });
</script>
