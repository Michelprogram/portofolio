---
interface Props {
  count?: number;
}

const { count = 8 } = Astro.props;
const meteors = Array.from({ length: count });
---

<div
  aria-hidden="true"
  class="meteor-container pointer-events-none fixed inset-0 z-50 overflow-hidden"
  data-component="meteor"
>
  {
    meteors.map((_, i) => (
      <div
        class="meteor absolute top-0 left-0 h-[1.5px] w-65 -rotate-45 bg-linear-to-r from-white via-white/80 to-transparent opacity-0 will-change-transform before:absolute before:top-1/2 before:-left-1 before:h-1 before:w-1.5 before:-translate-y-1/2 before:rounded-full before:bg-white before:shadow-[0_0_12px_3px_#fff]"
        data-meteor
        data-index={i}
      />
    ))
  }
</div>

<script>
  import { MediaQuery, useGsap } from "@/composables";

  const { worker } = useGsap();

  worker({ selector: "[data-component='meteor']" }, (gsap, root) => {
    const meteorElements =
      root.querySelectorAll<HTMLDivElement>("[data-meteor]");
    if (meteorElements.length === 0) return;

    const mm = gsap.matchMedia();

    mm.add(MediaQuery.reduceMotion, () => {
      gsap.set(meteorElements, { opacity: 0 });
    });

    const launchMeteor = (el: HTMLDivElement, speedFactor = 1) => {
      const screenWidth = window.innerWidth;
      const screenHeight = window.innerHeight;

      const startX = gsap.utils.random(screenWidth * 0.2, screenWidth * 1.4);
      const startY = gsap.utils.random(-150, screenHeight * 0.4);

      const travelDistance = gsap.utils.random(800, 1400);
      const duration = gsap.utils.random(3, 6) * speedFactor;
      const delay = gsap.utils.random(2, 8);
      const scale = gsap.utils.random(0.6, 1.2);

      const rad = (45 * Math.PI) / 180;
      const targetX = startX - Math.cos(rad) * travelDistance;
      const targetY = startY + Math.sin(rad) * travelDistance;

      gsap.fromTo(
        el,
        {
          x: startX,
          y: startY,
          scale,
          opacity: 0,
        },
        {
          x: targetX,
          y: targetY,
          duration,
          delay,
          ease: "power1.in",
          keyframes: [
            { opacity: 0, offset: 0 },
            { opacity: 1, offset: 0.15 },
            { opacity: 0.8, offset: 0.7 },
            { opacity: 0, offset: 1 },
          ],
          onComplete: () => {
            launchMeteor(el, speedFactor);
          },
        },
      );
    };

    mm.add(MediaQuery.isDesktop, () => {
      meteorElements.forEach((el, index) => {
        gsap.delayedCall(index * 0.6, () => launchMeteor(el, 1));
      });
    });

    mm.add(MediaQuery.isMobile, () => {
      const activeMobileMeteors = Array.from(meteorElements).slice(0, 4);
      activeMobileMeteors.forEach((el, index) => {
        gsap.delayedCall(index * 0.8, () => launchMeteor(el, 1.2));
      });
    });
  });
</script>
