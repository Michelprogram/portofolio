---
interface Props {
  sections: {
    selector: string;
    title: string;
  }[];
}

const { sections } = Astro.props;
---

<div
  class="xl:visible xl:fixed xl:top-1/2 xl:right-7 xl:z-10 xl:-translate-y-1/2"
  data-component="stack"
>
  <ul class="flex flex-col">
    {
      sections.map((section) => (
        <li
          class="relative flex min-h-8 min-w-12 cursor-pointer items-center justify-end px-3 py-2"
          data-stack-row
        >
          <span
            data-stack-label
            class="pointer-events-none absolute right-full mr-2 text-sm whitespace-nowrap text-white opacity-0"
          >
            {section.title}
          </span>
          <svg
            data-stack-item={section.selector}
            width="24"
            height="4"
            viewBox="0 10 24 4"
            fill="none"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="pointer-events-none cursor-pointer"
          >
            <path d="M5 12h14" class="stroke-neutral-500" />
            <path d="M5 12h14" class="stroke-primary-green" data-stack-fill />
          </svg>
        </li>
      ))
    }
  </ul>
</div>
<script>
  import { useGsap } from "@/composables";
  import { isAbsent, isPresent } from "@/utils";
  import { ScrollSmoother } from "gsap/ScrollSmoother";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const { worker } = useGsap();

  worker({ selector: "[data-component='stack']" }, (gsap, root) => {
    const items = root.querySelectorAll<SVGElement>("[data-stack-item]");

    const entries = [...items].flatMap((item) => {
      const selector = item.dataset.stackItem;
      const section = document.querySelector(`[data-component='${selector}']`);
      const fill = item.querySelector<SVGPathElement>("[data-stack-fill]");
      if (isAbsent(section) || isAbsent(fill)) return [];
      return [{ item, section, fill }];
    });

    entries.forEach(({ item, section, fill }, i) => {
      const prev = entries[i - 1];
      const row = item.closest<HTMLElement>("[data-stack-row]");

      if (isAbsent(row)) return;

      const label = row.querySelector<HTMLElement>("[data-stack-label]");

      if (isAbsent(label)) return;

      gsap.set(label, { autoAlpha: 0, x: 12 });

      const tlLabel = gsap.timeline({ paused: true });

      tlLabel.to(label, {
        autoAlpha: 1,
        x: 0,
        duration: 0.35,
        ease: "power2.out",
      });

      row.addEventListener("mouseenter", () => tlLabel.play());

      row.addEventListener("mouseleave", () => tlLabel.reverse());

      row.addEventListener("click", () => {
        const smoother = ScrollSmoother.get();
        if (isPresent(smoother))
          smoother.scrollTo(section, true, "center center");
        else section.scrollIntoView({ behavior: "smooth" });
      });

      gsap.set(fill, { drawSVG: "0% 0%" });

      const isFirst = i === 0;
      const isLast = i === entries.length - 1;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: prev?.section ?? section,
          start: isFirst ? "top top" : "bottom center",
          endTrigger: section,
          end: isLast ? "bottom bottom" : "bottom center",
          scrub: true,
          refreshPriority: -1,
          invalidateOnRefresh: true,
        },
      });

      tl.fromTo(
        fill,
        { drawSVG: "0% 0%" },
        { drawSVG: "0% 100%", ease: "none" },
      );

      tl.to(fill, { drawSVG: "100% 100%", ease: "none" });
    });

    ScrollTrigger.refresh();
  });
</script>
