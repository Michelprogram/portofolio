---
interface Props {
  sections: {
    selector: string;
    title: string;
  }[];
}

const { sections } = Astro.props;
---

<div
  class="hidden xl:visible xl:fixed xl:top-1/2 xl:right-7 xl:-translate-y-1/2 xl:z-10"
  data-component="stack"
>
  <ul class="flex flex-col">
    {
      sections.map((section) => (
        <li
          class="relative flex min-h-8 min-w-12 cursor-pointer items-center justify-end px-3 py-2"
          data-stack-row
        >
          <span
            data-stack-label
            class="pointer-events-none absolute right-full mr-2 whitespace-nowrap text-sm text-white"
          >
            {section.title}
          </span>
          <svg
            data-stack-item={section.selector}
            width="24"
            height="4"
            viewBox="0 10 24 4"
            fill="none"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="pointer-events-none"
          >
            <path d="M5 12h14" class="stroke-neutral-500" />
            <path d="M5 12h14" class="stroke-primary-green" data-stack-fill />
          </svg>
        </li>
      ))
    }
  </ul>
</div>
<script>
  import { useGsap } from "@/composables";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrollSmoother } from "gsap/ScrollSmoother";

  const { worker } = useGsap();

  worker("[data-component='stack']", (gsap, root) => {
    const items = root.querySelectorAll<SVGElement>("[data-stack-item]");

    const entries = [...items].flatMap((item) => {
      const selector = item.dataset.stackItem!;
      const section = document.querySelector(`[data-component='${selector}']`);
      const fill = item.querySelector<SVGPathElement>("[data-stack-fill]");
      if (!section || !fill) return [];
      return [{ item, section, fill }];
    });

    entries.forEach(({ item, section, fill }, i) => {
      const prev = entries[i - 1];
      const row = item.closest<HTMLElement>("[data-stack-row]");
      const label = row?.querySelector<HTMLElement>("[data-stack-label]");
      if (!row) return;

      if (label) {
        gsap.set(label, { autoAlpha: 0, x: 12 });
        row.addEventListener("mouseenter", () => {
          gsap.to(label, {
            autoAlpha: 1,
            x: 0,
            duration: 0.35,
            ease: "power2.out",
          });
        });
        row.addEventListener("mouseleave", () => {
          gsap.to(label, {
            autoAlpha: 0,
            x: 12,
            duration: 0.25,
            ease: "power2.in",
          });
        });
      }

      row.addEventListener("click", () => {
        const smoother = ScrollSmoother.get();
        if (smoother) smoother.scrollTo(section, true, "top center");
        else section.scrollIntoView({ behavior: "smooth" });
      });

      item.style.cursor = "pointer";
      item.addEventListener("click", () => {
        const smoother = ScrollSmoother.get();
        if (smoother) {
          smoother.scrollTo(section, true, "top center");
        } else {
          section.scrollIntoView({ behavior: "smooth" });
        }
      });

      gsap.set(fill, { drawSVG: "0% 0%" });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: prev?.section ?? section,
          start: prev ? "bottom center" : "top center",
          endTrigger: section,
          end: "bottom center",
          scrub: true,
        },
      });

      // 1ʳᵉ moitié : remplit gauche → droite
      tl.fromTo(
        fill,
        { drawSVG: "0% 0%" },
        { drawSVG: "0% 100%", ease: "none" },
      );
      // 2ᵉ moitié : undraw vers la droite
      tl.to(fill, { drawSVG: "100% 100%", ease: "none" });
    });
  });
</script>
