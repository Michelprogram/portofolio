---
import { useI18n } from "@/composables";
import Article from "./Article.astro";

const { translation } = useI18n(Astro.currentLocale);

const {
  articles: { title, items, description },
} = translation;
---

<section
  class="size-full flex gap-8 flex-col items-center justify-center w-6xl m-auto border-t-2 border-solid mb-12"
  data-component="articles"
>
  <h2 class="text-7xl w-full tracking-wide mt-12">
    {title}
    <span class="text-xs italic font-normal">({description})</span>
  </h2>
  <div class="w-full flex gap-6 px-12">
    {items.map((article, index) => <Article article={article} index={index} />)}
  </div>
</section>
