---
import { useI18n } from "@/composables";
import Article from "./Article.astro";

import { getCollection } from "astro:content";

const { translation } = useI18n(Astro.currentLocale);

const {
  articles: { title, description },
} = translation;

const articles = await getCollection("articles");
---

<section
  class="size-full flex gap-8 flex-col items-center justify-center w-6xl m-auto border-t-2 border-solid mb-12"
  data-component="articles"
>
  <h2 class="text-7xl w-full tracking-wide mt-12">
    {title}
    <span class="text-xs italic font-normal">({description})</span>
  </h2>
  <div
    class="w-full flex gap-6 px-12 perspective-distant h-[500px]"
    data-section
  >
    <div
      class="relative transform-3d w-[250px] h-[400px] mx-auto"
      data-container
    >
      {
        articles.map((article, index) => (
          <div
            data-cards
            class="bg-red-600 absolute top-0 left-0 transform-3d w-[250px] h-[400px] flex items-center justify-center border-2 rounded-2xl"
          >
            <p class="text-center">Content</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
<script>
  import { useGsap } from "@/composables";
  import { Draggable } from "gsap/Draggable";

  const { worker } = useGsap();

  worker({ selector: "[data-component='articles']" }, (gsap, root) => {
    const cards = root.querySelectorAll("[data-cards]");

    const cardW = 500;
    const n = cards.length;
    const radius = cardW / (2 * Math.tan(Math.PI / n));
    const step = 360 / cards.length;
    cards.forEach((card, index) => {
      gsap.set(card, {
        transformOrigin: `50% 50% ${-radius}px`,
        rotateY: index * 120,
      });
    });

    const ring = root.querySelector("[data-container]");

    gsap.set(ring, {
      transformOrigin: `50% 50% ${-radius}px`,
    });
    const stage = root.querySelector("[data-section]");

    const blurOn = () =>
      gsap.to(stage, { filter: "blur(4px)", duration: 0.2, overwrite: "auto" });
    const blurOff = () =>
      gsap.to(stage, {
        filter: "blur(0px)",
        duration: 0.35,
        overwrite: "auto",
      });

    const proxy = document.createElement("div");
    const dragSpeed = 0.1;
    let rot = 0;
    Draggable.create(proxy, {
      type: "x",
      trigger: root.querySelector("[data-section]"),
      inertia: true,
      onDragStart() {
        blurOn();
      },
      onDragEnd() {
        // release sans inertia (presque pas de vitesse)
        if (!this.tween) blurOff();
      },
      onDrag() {
        rot += this.deltaX * dragSpeed;
        gsap.set(ring, { rotateY: rot });
      },
      onThrowUpdate() {
        rot += this.deltaX * dragSpeed;
        gsap.set(ring, { rotateY: rot });
      },
      onThrowComplete() {
        const snapped = gsap.utils.snap(step, rot);
        rot = snapped;
        gsap.to(ring, {
          rotateY: snapped,
          duration: 2,
          ease: "elastic.out(1, 0.6)",
        });
        blurOff();
      },
    });
  });
</script>
