---
import LanguageSwitch from "@/components/ui/languageSwitch.astro";
---

<header
  class="mt-4 size-full md:px-10 lg:px-20 xl:my-6 xl:px-32"
  data-component="header"
>
  <nav
    class="flex flex-col flex-wrap justify-center gap-y-4 text-center md:flex-row md:justify-between lg:gap-x-6.25"
  >
    <a class="text-3xl font-medium" data-gsap-name href="/">Dorian Gauron</a>
    <div class="flex flex-wrap justify-center gap-5 xl:gap-8">
      <a
        href="https://github.com/Michelprogram"
        class="text-text-1 transition-colors duration-200"
        target="_blank"
        aria-label="github repositories"
        rel="noopener noreferrer"
        data-gsap-social
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 640 640"
          class="hover:text-primary-green block size-8 fill-current transition-colors duration-200 md:size-8.25 xl:size-8.75"
        >
          <path
            d="M280.5 426.5C214.5 418.5 168 371 168 309.5C168 284.5 177 257.5 192 239.5C185.5 223 186.5 188 194 173.5C214 171 241 181.5 257 196C276 190 296 187 320.5 187C345 187 365 190 383 195.5C398.5 181.5 426 171 446 173.5C453 187 454 222 447.5 239C463.5 258 472 283.5 472 309.5C472 371 425.5 417.5 358.5 426C375.5 437 387 461 387 488.5L387 540.5C387 555.5 399.5 564 414.5 558C505 523.5 576 433 576 321C576 179.5 461 64 319.5 64C178 64 64 179.5 64 321C64 432 134.5 524 229.5 558.5C243 563.5 256 554.5 256 541L256 501C249 504 240 506 232 506C199 506 179.5 488 165.5 454.5C160 441 154 433 142.5 431.5C136.5 431 134.5 428.5 134.5 425.5C134.5 419.5 144.5 415 154.5 415C169 415 181.5 424 194.5 442.5C204.5 457 215 463.5 227.5 463.5C240 463.5 248 459 259.5 447.5C268 439 274.5 431.5 280.5 426.5z"
          ></path></svg
        >
      </a>

      <a
        href="https://www.linkedin.com/in/dorian-gauron-534716187/"
        class="transition-colors duration-200"
        target="_blank"
        aria-label="indeed profile"
        rel="noopener noreferrer"
        data-gsap-social
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 640 640"
          class="hover:text-primary-green block size-8 fill-current transition-colors duration-200 xl:size-8.75"
        >
          <path
            d="M512 96L127.9 96C110.3 96 96 110.5 96 128.3L96 511.7C96 529.5 110.3 544 127.9 544L512 544C529.6 544 544 529.5 544 511.7L544 128.3C544 110.5 529.6 96 512 96zM231.4 480L165 480L165 266.2L231.5 266.2L231.5 480L231.4 480zM198.2 160C219.5 160 236.7 177.2 236.7 198.5C236.7 219.8 219.5 237 198.2 237C176.9 237 159.7 219.8 159.7 198.5C159.7 177.2 176.9 160 198.2 160zM480.3 480L413.9 480L413.9 376C413.9 351.2 413.4 319.3 379.4 319.3C344.8 319.3 339.5 346.3 339.5 374.2L339.5 480L273.1 480L273.1 266.2L336.8 266.2L336.8 295.4L337.7 295.4C346.6 278.6 368.3 260.9 400.6 260.9C467.8 260.9 480.3 305.2 480.3 362.8L480.3 480z"
          ></path></svg
        >
      </a>

      <a
        href="https://twitter.com/michel_le_dev"
        class="transition-colors duration-200"
        target="_blank"
        aria-label="x profile"
        rel="noopener noreferrer"
        data-gsap-social
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 640 640"
          class="hover:text-primary-green block size-8 fill-current transition-colors duration-200 xl:size-8.75"
        >
          <path
            d="M160 96C124.7 96 96 124.7 96 160L96 480C96 515.3 124.7 544 160 544L480 544C515.3 544 544 515.3 544 480L544 160C544 124.7 515.3 96 480 96L160 96zM457.1 180L353.3 298.6L475.4 460L379.8 460L305 362.1L219.3 460L171.8 460L282.8 333.1L165.7 180L263.7 180L331.4 269.5L409.6 180L457.1 180zM419.3 431.6L249.4 206.9L221.1 206.9L392.9 431.6L419.3 431.6z"
          ></path></svg
        >
      </a>
      <LanguageSwitch />
    </div>
  </nav>
</header>
<script>
  import { SplitText } from "gsap/SplitText";
  import { useGsap } from "@/composables";

  const { worker } = useGsap();

  worker({ selector: "[data-component='header']" }, (gsap) => {
    const linesSplit = SplitText.create("[data-gsap-name]", {
      type: "lines",
      mask: "lines",
    });

    const tl = gsap.timeline();

    tl.from(linesSplit.lines, {
      duration: 1,
      y: 100,
      autoAlpha: 0,
      ease: "power3.out",
    });

    tl.from(
      "[data-gsap-social]",
      {
        duration: 0.8,
        y: 100,
        autoAlpha: 0,
        stagger: 0.55,
        ease: "power3.out",
      },
      "-=0.5",
    );
  });
</script>
